# EV-Diag-Tool 环境变量配置
# 复制此文件为 .env 并修改配置

# ── AI Provider ──
# 可选: ollama / openai（默认 ollama）
AI_PROVIDER=ollama

# ── Ollama 配置（本地模型）──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b

# ── OpenAI 兼容 API 配置（调用模型）──
# 支持多个端点，按编号递增即可
# 每个端点需要: NAME(显示名)、URL(接口地址)、KEY(API密钥)、MODEL(模型名)

# 端点 1 示例：DeepSeek
# OPENAI_ENDPOINT_1_NAME=DeepSeek
# OPENAI_ENDPOINT_1_URL=https://api.deepseek.com/v1
# OPENAI_ENDPOINT_1_KEY=sk-your-deepseek-key
# OPENAI_ENDPOINT_1_MODEL=deepseek-chat

# 端点 2 示例：OpenAI
# OPENAI_ENDPOINT_2_NAME=OpenAI
# OPENAI_ENDPOINT_2_URL=https://api.openai.com/v1
# OPENAI_ENDPOINT_2_KEY=sk-your-openai-key
# OPENAI_ENDPOINT_2_MODEL=gpt-4o-mini

# 端点 3 示例：本地 LM Studio
# OPENAI_ENDPOINT_3_NAME=LM Studio
# OPENAI_ENDPOINT_3_URL=http://localhost:1234/v1
# OPENAI_ENDPOINT_3_KEY=lm-studio
# OPENAI_ENDPOINT_3_MODEL=local-model

# 向后兼容：如果只配一个端点，也可以用以下格式
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4o-mini

# ── AI 生成参数 ──
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT=90
AI_MAX_RETRIES=3

# ── 数据库 ──
# 数据库路径（留空则使用默认路径 data/obd_codes.db）
# DB_PATH=

# ── 日志 ──
LOG_LEVEL=INFO
