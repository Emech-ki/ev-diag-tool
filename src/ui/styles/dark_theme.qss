/* EV-Diag-Tool 深色主题样式 */
/* 当前为预留文件，后续阶段启用 */

QMainWindow {
    background-color: #1E1E1E;
}

QLabel {
    color: #E0E0E0;
}

QLineEdit {
    background-color: #2D2D2D;
    color: #E0E0E0;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    padding: 4px 8px;
}

QLineEdit:focus {
    border: 1px solid #1976D2;
}

QPushButton {
    background-color: #1976D2;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #1565C0;
}

QTextBrowser {
    background-color: #252525;
    color: #E0E0E0;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
    padding: 8px;
}

QGroupBox {
    color: #B0B0B0;
    border: 1px solid #3D3D3D;
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 16px;
}

QTabWidget::pane {
    background-color: #1E1E1E;
    border: 1px solid #3D3D3D;
}

QTabBar::tab {
    background-color: #2D2D2D;
    color: #999;
    padding: 8px 16px;
    border: 1px solid #3D3D3D;
    border-bottom: none;
}

QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #1976D2;
    border-bottom: 2px solid #1976D2;
}

QStatusBar {
    background-color: #252525;
    color: #999;
}
